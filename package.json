{
  "name": "zoomcut",
  "version": "0.1.0-beta.1",
  "description": "ZoomCut — screen recorder with automatic zoom-to-click, plus editor",
  "author": "ZoomCut",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w uiohook-napi",
    "postinstall": "electron-rebuild -f -w uiohook-napi || true",
    "dist:mac": "electron-builder --mac dmg",
    "server": "node electron/server.js",
    "stage:android-tools": "bash scripts/stage-android-tools.sh",
    "stage:runtime-tools": "bash scripts/stage-runtime-tools.sh",
    "test": "node --test test/*.test.js",
    "test:security": "node --test test/security.test.js",
    "qa": "npm test && node --check electron/main.js && node --check electron/server.js && node --check electron/preload.js"
  },
  "build": {
    "appId": "com.zoomcut.app",
    "productName": "ZoomCut",
    "afterPack": "electron/after-pack.js",
    "files": [
      "electron/**/*",
      "shared/**/*",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "darkModeSupport": true,
      "extendInfo": {
        "NSCameraUsageDescription": "ZoomCut ใช้กล้องสำหรับเว็บแคม overlay",
        "NSMicrophoneUsageDescription": "ZoomCut ใช้ไมโครโฟนสำหรับบันทึกเสียง",
        "NSScreenCaptureUsageDescription": "ZoomCut ต้องการสิทธิ์อัดหน้าจอเพื่อบันทึกหน้าต่าง"
      }
    },
    "dmg": {
      "title": "ZoomCut ${version}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^4.2.0",
    "@electron/fuses": "^2.1.3"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  }
}
